<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="TechZone — cart and checkout" enabled="true">
      <stringProp name="TestPlan.comments">The cross-service ordering path under concurrency: register, sign in, find a product in stock, add it to the cart, read the cart, place the order, read the order history. Every thread registers its OWN account - the seeded demo accounts share one cart per user, and two threads writing the same cart corrupts it (BUG-21). This plan WRITES: accounts, carts, orders, and stock decrements. Since ADR-0012 the platform issues no tokens: each thread creates its account through Keycloak's Admin API and then obtains a real RS256 access token by password grant against the techzone-tests client, which it sends as a bearer header. Access tokens live five minutes, so the plan fetches one at the start of the loop and fetches a new one a minute before it expires - the load and stress stages outlast a single token. See tests/load/README.md.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="Workload variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="gatewayHost" elementType="Argument">
            <stringProp name="Argument.name">gatewayHost</stringProp>
            <stringProp name="Argument.value">${__P(gateway.host,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="gatewayPort" elementType="Argument">
            <stringProp name="Argument.name">gatewayPort</stringProp>
            <stringProp name="Argument.value">${__P(gateway.port,8080)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="paymentMethod" elementType="Argument">
            <stringProp name="Argument.name">paymentMethod</stringProp>
            <stringProp name="Argument.value">${__P(payment.method,online)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">The value the SPA sends. It is a free-text string the service only stores - nothing branches on it and Stripe is not called. Do not shorten it: Payment.paymentMethod carries @Size(min = 4), the check runs at persist time rather than on the request, and anything shorter (the "cod" the system suite uses) fails the whole order with 500 instead of 400. See BUG-22 in docs/backend/known-defects.md.</stringProp>
          </elementProp>
          <elementProp name="shopperPassword" elementType="Argument">
            <stringProp name="Argument.name">shopperPassword</stringProp>
            <stringProp name="Argument.value">${__P(shopper.password,LoadTest1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Throw-away credential for accounts that exist only in a development realm. Must satisfy the realm password policy, which is length(8).</stringProp>
          </elementProp>
          <elementProp name="keycloakBase" elementType="Argument">
            <stringProp name="Argument.name">keycloakBase</stringProp>
            <stringProp name="Argument.value">${__P(keycloak.base,http://localhost:8090)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">ADR-0012. Keycloak is NOT behind the gateway, so these samplers address it directly rather than through the gateway defaults below.</stringProp>
          </elementProp>
          <elementProp name="keycloakRealm" elementType="Argument">
            <stringProp name="Argument.name">keycloakRealm</stringProp>
            <stringProp name="Argument.value">${__P(keycloak.realm,techzone)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="testsClientId" elementType="Argument">
            <stringProp name="Argument.name">testsClientId</stringProp>
            <stringProp name="Argument.value">${__P(keycloak.tests.client,techzone-tests)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">The only client in the realm with direct access grants enabled. techzone-spa has them off, so no password ever reaches the client the application uses.</stringProp>
          </elementProp>
          <elementProp name="testsClientSecret" elementType="Argument">
            <stringProp name="Argument.name">testsClientSecret</stringProp>
            <stringProp name="Argument.value">${__P(keycloak.tests.secret,techzone-tests-dev-secret)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Development default. Override with -Jkeycloak.tests.secret for any realm that is not the committed one.</stringProp>
          </elementProp>
          <elementProp name="adminClientId" elementType="Argument">
            <stringProp name="Argument.name">adminClientId</stringProp>
            <stringProp name="Argument.value">${__P(keycloak.admin.client,techzone-admin-api)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="adminClientSecret" elementType="Argument">
            <stringProp name="Argument.name">adminClientSecret</stringProp>
            <stringProp name="Argument.value">${__P(keycloak.admin.secret,techzone-admin-api-dev-secret)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Needed only to create the throw-away accounts: registration is a browser flow on Keycloak's page and there is no platform endpoint that creates a customer.</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
