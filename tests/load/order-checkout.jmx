            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract accessToken" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">accessToken</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.access_token</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Schedule the next refresh" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// Access tokens live five minutes (ADR-0012), and the load and stress stages run
// for five and ten. Refresh a minute early so no journey sampler ever carries an
// expired token - a 401 here would be a test artefact, not a platform result.
if (prev.isSuccessful()) {
    def body = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
    long ttl = (body.expires_in ?: 300) as long
    vars.put('tokenRefreshAt', String.valueOf(System.currentTimeMillis() + Math.max(ttl - 60, 30) * 1000L))
}</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="200 OK" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
              <stringProp name="Assertion.custom_message">Sign-in failed; every later sampler in this thread will now get a gateway 401.</stringProp>
            </ResponseAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>
