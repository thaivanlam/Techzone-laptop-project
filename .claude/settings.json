{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/export_session.py\" --from-hook --quiet || true",
            "timeout": 120,
            "statusMessage": "Recording the session prompt log"
          }
        ]
      }
    ]
  }
}
