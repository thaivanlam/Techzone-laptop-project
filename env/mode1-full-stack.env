# =====================================================================
# Mode 1 — Full stack in Docker (backend + frontend)
# Target: copy to the repo root as `.env`
#   cp env/mode1-full-stack.env .env
# See docs/operations/running-locally.md#mode-1--full-stack-in-docker
# No secrets included — fill in the blanks locally, never commit the result.
# =====================================================================

SPRING_PROFILES_ACTIVE=prod
COMPOSE_PROFILES=prod

# ---------------------------------------------------------------------
# SECRETS — fill in locally, do not commit
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=
MAIL_PASSWORD=
VITE_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------
# URLS AND PORTS
# ---------------------------------------------------------------------
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
VITE_BACK_END_URL=
API_GATEWAY_URL=http://api-gateway:8080
IMAGE_BASE_URL=http://localhost:5173/product-manager/images

# Change if a native mysqld already listens on 3306 on the host.
MYSQL_PORT=3306
