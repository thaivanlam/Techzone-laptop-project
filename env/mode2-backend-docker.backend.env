# =====================================================================
# Mode 2 — Backend in Docker, frontend on the Vite dev server
# Target: copy to backend/.env
#   cp env/mode2-backend-docker.backend.env backend/.env
# Pair with env/mode2-backend-docker.frontend.env -> frontend/.env
# See docs/operations/running-locally.md#mode-2--backend-in-docker-frontend-on-vite
# No secrets included — fill in the blanks locally, never commit the result.
# =====================================================================

SPRING_PROFILES_ACTIVE=prod
COMPOSE_PROFILES=prod

# ---------------------------------------------------------------------
# SECRETS — fill in locally, do not commit
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=
MAIL_PASSWORD=

# ---------------------------------------------------------------------
# OBSERVABILITY — only used when COMPOSE_PROFILES includes `observability`
# ---------------------------------------------------------------------
# Grafana is 3000 in the container; 3001 on the host keeps 3000 free for a
# frontend dev server, which the gateway allows as a CORS origin.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------
# KEYCLOAK (ADR-0012)
# ---------------------------------------------------------------------
# Console bootstrap account and the service-account secret. Names only - fill in
# locally, never commit the values. The compose defaults are development-only.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_TESTS_CLIENT_SECRET=
KEYCLOAK_PORT=8090

# Two URLs, deliberately. KEYCLOAK_ISSUER_URI is the PUBLIC address: it is what
# the `iss` claim holds, because that is the host the browser used, and it is
# only ever compared - never fetched. KEYCLOAK_JWK_SET_URI and KEYCLOAK_BASE_URL
# are the addresses a SERVICE can reach, which inside Docker is the container
# name. Setting them to the same value is the usual cause of "401 on every
# request" in one mode and not the other.
KEYCLOAK_ISSUER_URI=http://localhost:8090/realms/techzone
KEYCLOAK_JWK_SET_URI=http://keycloak:8090/realms/techzone/protocol/openid-connect/certs
KEYCLOAK_BASE_URL=http://keycloak:8090
