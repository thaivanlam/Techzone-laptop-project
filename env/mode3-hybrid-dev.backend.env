# =====================================================================
# Mode 3 — Hybrid dev: infra in Docker, business services run from the IDE
# Target: copy to backend/.env
#   cp env/mode3-hybrid-dev.backend.env backend/.env
# Pair with env/mode3-hybrid-dev.frontend.env -> frontend/.env
# See docs/operations/running-locally.md#mode-3--hybrid-dev
#
# `docker-compose up -d` in backend/ then starts infra only (mysql, rabbitmq,
# config-server, discovery-service) because COMPOSE_PROFILES is empty.
# Business services (user/product/order/notification-service, api-gateway)
# are run individually from the IDE with SPRING_PROFILES_ACTIVE=dev, which
# points them at localhost — see the *-dev.yml files in
# backend/config-server/src/main/resources/config/.
#
# NOTE: those *-dev.yml files hardcode `localhost:3306` for MySQL — they do
# not read MYSQL_PORT. If a native mysqld already holds port 3306 on this
# machine, stop it before starting the infra containers (Windows: Stop-Service
# -Name MySQL80, run as Administrator), otherwise the mysql container cannot
# bind the host port.
#
# No secrets included — fill in the blanks locally, never commit the result.
# =====================================================================

SPRING_PROFILES_ACTIVE=dev
COMPOSE_PROFILES=

# ---------------------------------------------------------------------
# SECRETS — fill in locally, do not commit
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=
MAIL_PASSWORD=

# ---------------------------------------------------------------------
# OBSERVABILITY — only used when COMPOSE_PROFILES includes `observability`
# ---------------------------------------------------------------------
# Grafana is 3000 in the container; 3001 on the host keeps 3000 free for a
# frontend dev server, which the gateway allows as a CORS origin.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
#
# In this mode the business services run on the host, not as containers, so
# Prometheus cannot reach them by Compose service name. Uncomment the
# `techzone-hybrid-dev` job in backend/observability/prometheus/prometheus.yml
# before setting COMPOSE_PROFILES=observability here.

# ---------------------------------------------------------------------
# KEYCLOAK (ADR-0012)
# ---------------------------------------------------------------------
# Console bootstrap account and the service-account secret. Names only - fill in
# locally, never commit the values. The compose defaults are development-only.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_TESTS_CLIENT_SECRET=
KEYCLOAK_PORT=8090

# Two URLs, deliberately. KEYCLOAK_ISSUER_URI is the PUBLIC address: it is what
# the `iss` claim holds, because that is the host the browser used, and it is
# only ever compared - never fetched. KEYCLOAK_JWK_SET_URI and KEYCLOAK_BASE_URL
# are the addresses a SERVICE can reach, which inside Docker is the container
# name. Setting them to the same value is the usual cause of "401 on every
# request" in one mode and not the other.
KEYCLOAK_ISSUER_URI=http://localhost:8090/realms/techzone
# Mode 3 runs the services from the IDE, on the host, so here the reachable
# address is localhost and the two URLs coincide.
KEYCLOAK_JWK_SET_URI=http://localhost:8090/realms/techzone/protocol/openid-connect/certs
KEYCLOAK_BASE_URL=http://localhost:8090
