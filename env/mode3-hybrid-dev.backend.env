# =====================================================================
# Mode 3 — Hybrid dev: infra in Docker, business services run from the IDE
# Target: copy to backend/.env
#   cp env/mode3-hybrid-dev.backend.env backend/.env
# Pair with env/mode3-hybrid-dev.frontend.env -> frontend/.env
# See docs/operations/running-locally.md#mode-3--hybrid-dev
#
# `docker-compose up -d` in backend/ then starts infra only (mysql, rabbitmq,
# config-server, discovery-service) because COMPOSE_PROFILES is empty.
# Business services (user/product/order/notification-service, api-gateway)
# are run individually from the IDE with SPRING_PROFILES_ACTIVE=dev, which
# points them at localhost — see the *-dev.yml files in
# backend/config-server/src/main/resources/config/.
#
# NOTE: those *-dev.yml files hardcode `localhost:3306` for MySQL — they do
# not read MYSQL_PORT. If a native mysqld already holds port 3306 on this
# machine, stop it before starting the infra containers (Windows: Stop-Service
# -Name MySQL80, run as Administrator), otherwise the mysql container cannot
# bind the host port.
#
# No secrets included — fill in the blanks locally, never commit the result.
# =====================================================================

SPRING_PROFILES_ACTIVE=dev
COMPOSE_PROFILES=

# ---------------------------------------------------------------------
# SECRETS — fill in locally, do not commit
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=
MAIL_PASSWORD=
