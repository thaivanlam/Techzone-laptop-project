# =====================================================================
# Mode 2 — Backend in Docker, frontend on the Vite dev server
# Target: copy to frontend/.env
#   cp env/mode2-backend-docker.frontend.env frontend/.env
# Pair with env/mode2-backend-docker.backend.env -> backend/.env
# See docs/operations/running-locally.md#mode-2--backend-in-docker-frontend-on-vite
# No secrets included — fill in the blanks locally, never commit the result.
# =====================================================================

# The browser calls the gateway directly, so CORS is in play:
# FRONTEND_URL in backend/.env must match this origin.
VITE_BACK_END_URL=http://localhost:8080
VITE_FRONTEND_URL=http://localhost:5173

VITE_STRIPE_PUBLISHABLE_KEY=
