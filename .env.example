# =====================================================================
# TechZone — full stack configuration (root docker-compose.yml)
# Copy to .env and fill in the secrets:  cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# ENVIRONMENT SWITCH
# ---------------------------------------------------------------------
# Spring profile the services load from config-server (<service>-<profile>.yml)
#   dev  -> config points at localhost (business services run outside Docker)
#   prod -> config points at Docker network hostnames
SPRING_PROFILES_ACTIVE=prod

# Which containers Compose starts
#   prod      -> the whole stack, frontend included
#   (empty)   -> infrastructure only (mysql, rabbitmq, config-server,
#                discovery-service) for hybrid dev mode
COMPOSE_PROFILES=prod

# ---------------------------------------------------------------------
# SECRETS
# ---------------------------------------------------------------------
# Stripe test secret key (order-service payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here

# Gmail app password (notification-service email)
MAIL_PASSWORD=your_gmail_app_password_here

# Stripe publishable key — baked into the frontend bundle at image build time.
# Changing it requires `docker compose build frontend`.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ---------------------------------------------------------------------
# URLS AND PORTS
# ---------------------------------------------------------------------
# Host port the frontend is published on.
FRONTEND_PORT=5173

# Origin the browser loads the SPA from. Used for backend CORS and as the
# Stripe return URL. Must match FRONTEND_PORT.
FRONTEND_URL=http://localhost:5173

# Where the browser sends API calls.
#   (empty)                -> same origin, nginx proxies to the gateway
#   http://localhost:8080  -> browser calls the gateway directly (needs CORS)
# Baked into the bundle at build time.
VITE_BACK_END_URL=

# Where the frontend container forwards proxied API calls. Read at container
# start, so a change only needs `docker compose up -d frontend`.
API_GATEWAY_URL=http://api-gateway:8080

# Base URL product-service returns for product images. Routed through the
# frontend origin so the whole app is served from one host.
IMAGE_BASE_URL=http://localhost:5173/product-manager/images

# Host port for the MySQL container. Change it if a local mysqld already
# listens on 3306 (services always use mysql:3306 inside the network).
MYSQL_PORT=3306
